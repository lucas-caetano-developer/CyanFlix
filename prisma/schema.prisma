generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentKind {
  movie
  series
  anime
}

enum PackageType {
  movie
  season
}

enum PublicationState {
  waiting_files
  uploading
  ready
  validating
  promoting
  confirmed
  failed
}

enum AccountRole {
  owner
  admin
  viewer
}

model Account {
  id           String      @id @default(uuid())
  username     String      @unique
  passwordHash String
  role         AccountRole @default(viewer)
  disabled     Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  profiles     Profile[]
  editorialOverrides EditorialOverride[]
  auditLogs     AuditLog[]
}

model Work {
  id            String      @id @default(uuid())
  stableId      String      @unique
  contentKind   ContentKind
  title         String
  originalTitle String?
  year          Int?
  synopsis      String?
  searchText    String      @default("")
  providerIds   Json        @default("{}")
  metadata      Json        @default("{}")
  hidden        Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  seasons       Season[]
  episodes      Episode[]
  assets        Asset[]
  mediaObjects  MediaObject[]
  favorites     Favorite[]
  progress      ViewingProgress[]
  editorialOverride EditorialOverride?
  collectionItems EditorialCollectionItem[]
}

model EditorialCollection {
  id                   String   @id @default(uuid())
  slug                 String   @unique
  title                String
  description          String?
  state                String   @default("draft")
  active               Boolean  @default(true)
  featured             Boolean  @default(false)
  sortOrder             Int      @default(0)
  metadata              Json     @default("{}")
  createdByAccountId   String
  updatedByAccountId   String
  publishedAt           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  items                 EditorialCollectionItem[]

  @@index([state, active, sortOrder])
}

model EditorialCollectionItem {
  collectionId String
  workId       String
  position     Int      @default(0)
  createdAt    DateTime @default(now())

  collection   EditorialCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  work         Work                @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@id([collectionId, workId])
  @@index([collectionId, position])
  @@index([workId])
}

model EditorialOverride {
  id                 String   @id @default(uuid())
  workId             String   @unique
  title              String?
  synopsis           String?
  hidden             Boolean?
  featured           Boolean?
  metadata           Json     @default("{}")
  updatedByAccountId String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  work               Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  updatedBy          Account  @relation(fields: [updatedByAccountId], references: [id], onDelete: Restrict)

  @@index([featured, hidden])
}

model AuditLog {
  id             String   @id @default(uuid())
  actorAccountId String
  action         String
  targetType     String
  targetId       String
  beforeValue    Json?
  afterValue     Json?
  createdAt      DateTime @default(now())

  actor           Account @relation(fields: [actorAccountId], references: [id], onDelete: Restrict)

  @@index([targetType, targetId, createdAt])
  @@index([actorAccountId, createdAt])
}

model Season {
  id              String   @id @default(uuid())
  stableId        String   @unique
  workId          String
  number          Int
  title           String?
  metadata        Json     @default("{}")
  completeness    Json     @default("{}")
  activeRevisionId String?
  hidden          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  work            Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  episodes        Episode[]
  assets          Asset[]
}

model Episode {
  id               String   @id @default(uuid())
  stableId         String   @unique
  workId           String
  seasonId         String
  number           Int
  absoluteNumber   Int?
  title            String?
  synopsis         String?
  metadata         Json     @default("{}")
  markers          Json     @default("[]")
  sourceSha256     String?
  mediaManifest    String?
  activeRevisionId String?
  hidden           Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  work             Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  season           Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  assets           Asset[]
  mediaObjects     MediaObject[]
  progress         ViewingProgress[]
}

model Asset {
  id             String   @id @default(uuid())
  stableId       String
  type           String
  relativePath   String
  publicPath     String?
  sizeBytes      BigInt
  sha256         String
  metadata       Json     @default("{}")
  workId         String?
  seasonId       String?
  episodeId      String?
  publicationId  String?
  createdAt      DateTime @default(now())

  work           Work?        @relation(fields: [workId], references: [id], onDelete: SetNull)
  season         Season?      @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  episode        Episode?     @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  publication    Publication? @relation(fields: [publicationId], references: [id], onDelete: SetNull)

  @@unique([publicationId, relativePath])
}

model MediaObject {
  id             String   @id @default(uuid())
  kind           String
  relativePath   String
  publicPath     String?
  sha256         String?
  sizeBytes      BigInt?
  codecs         Json     @default("{}")
  workId         String?
  episodeId      String?
  publicationId  String?
  createdAt      DateTime @default(now())

  work           Work?        @relation(fields: [workId], references: [id], onDelete: SetNull)
  episode        Episode?     @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  publication    Publication? @relation(fields: [publicationId], references: [id], onDelete: SetNull)

  @@unique([publicationId, relativePath])
  @@index([workId, kind])
  @@index([episodeId, kind])
}

model Publication {
  id              String           @id @default(uuid())
  uploadId        String           @unique
  packageId       String           @unique
  idempotencyKey  String           @unique
  packageType     PackageType
  manifestSha256  String
  manifest        Json
  state           PublicationState @default(waiting_files)
  errorMessage    String?
  finalizationAttempts Int         @default(0)
  finalizationWorkerId String?
  finalizationLeaseUntil DateTime?
  finalizationNextAttemptAt DateTime?
  finalizationHeartbeatAt DateTime?
  totalSizeBytes  BigInt?
  confirmedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  files           PublicationFile[]
  receipt         PublicationReceipt?
  revisions       Revision[]
  assets          Asset[]
  mediaObjects    MediaObject[]

  @@index([state, finalizationNextAttemptAt, finalizationLeaseUntil])
}

model PublicationFile {
  id             String      @id @default(uuid())
  publicationId  String
  relativePath   String
  expectedSha256 String?
  expectedBytes  BigInt?
  receivedSha256 String?
  receivedBytes  BigInt?
  receivedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  publication    Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([publicationId, relativePath])
}

model PublicationReceipt {
  id                String      @id @default(uuid())
  publicationId     String      @unique
  packageId         String
  remoteWorkId      String?
  remoteSeasonId    String?
  remoteEpisodeIds  Json        @default("{}")
  remoteRevision    Int
  manifestSha256    String
  status            String      @default("confirmed")
  confirmedAt       DateTime    @default(now())

  publication        Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
}

model Revision {
  id            String      @id @default(uuid())
  publicationId String
  number        Int
  scopeKey      String
  snapshot      Json        @default("{}")
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())

  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([scopeKey, number])
}

model RevisionCleanupJob {
  id                   String   @id @default(uuid())
  publicationId        String   @unique
  state                String   @default("queued")
  requestedByAccountId String
  attempts             Int      @default(0)
  sizeBytes             BigInt?
  error                 String?
  workerId              String?
  leaseUntil            DateTime?
  createdAt             DateTime @default(now())
  startedAt             DateTime?
  completedAt           DateTime?
  updatedAt             DateTime @updatedAt

  @@index([state, leaseUntil, createdAt])
}

model Profile {
  id        String   @id @default(uuid())
  accountId String?
  name      String
  avatar    String?
  role      String   @default("viewer")
  preferences Json   @default("{}")
  pinHash   String?
  maxAgeRating Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  favorites Favorite[]
  progress  ViewingProgress[]

  @@index([accountId, createdAt])
}

model Favorite {
  id        String   @id @default(uuid())
  profileId String
  workId    String
  createdAt DateTime @default(now())

  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([profileId, workId])
}

model ViewingProgress {
  id              String   @id @default(uuid())
  profileId       String
  workId          String?
  episodeId       String?
  positionSeconds Int      @default(0)
  durationSeconds Int?
  completed       Boolean  @default(false)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  profile         Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  work            Work?    @relation(fields: [workId], references: [id], onDelete: Cascade)
  episode         Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([profileId, updatedAt])
  @@unique([profileId, workId])
  @@unique([profileId, episodeId])
}

model TranscodeJob {
  id          String   @id @default(uuid())
  cacheKey    String   @unique
  sourcePath  String
  outputPath  String
  state       String   @default("queued")
  error       String?
  sizeBytes   BigInt?
  lastAccessAt DateTime?
  protectedUntil DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([state, createdAt])
  @@index([state, protectedUntil, lastAccessAt])
}

model IntegrityCheck {
  id            String    @id @default(uuid())
  bucket        String    @unique
  state         String    @default("running")
  checkedAssets Int       @default(0)
  hashedAssets  Int       @default(0)
  missingAssets Int       @default(0)
  corruptAssets Int       @default(0)
  details       Json      @default("[]")
  startedAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([startedAt])
}
