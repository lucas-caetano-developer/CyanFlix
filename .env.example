NODE_ENV=production
APP_URL=http://localhost:8080
PORT=3000
TRUST_PROXY=true

POSTGRES_DB=cyanflix
POSTGRES_USER=cyanflix
POSTGRES_PASSWORD=change-me-with-a-long-random-password
DATABASE_URL=postgresql://cyanflix:URL_ENCODED_PASSWORD@postgres:5432/cyanflix

PUBLISHER_TOKEN=change-me-with-at-least-32-random-characters
# Usada apenas para criar a conta "owner" no primeiro bootstrap.
ADMIN_PASSWORD=change-me-with-at-least-24-random-characters
SESSION_SECRET=change-me-with-at-least-32-random-characters
SESSION_TTL_HOURS=168
PUBLISHER_ACCESS_TTL_MINUTES=15

DATA_ROOT=/data
MAX_UPLOAD_SIZE_BYTES=10737418240
MAX_PACKAGE_SIZE_BYTES=536870912000
MAX_PACKAGE_FILES=100000
API_BODY_LIMIT_BYTES=2097152
MANIFEST_BODY_LIMIT_BYTES=67108864

FFMPEG_CONCURRENCY=1
FFMPEG_PRESET=veryfast
FFMPEG_CRF=22
TRANSCODE_CACHE_MAX_GB=100
TRANSCODE_CACHE_TTL_HOURS=168

PUBLICATION_WORKERS=1
PUBLICATION_MAX_ATTEMPTS=3
PUBLICATION_LEASE_SECONDS=120
INTEGRITY_INTERVAL_HOURS=24
INTEGRITY_HASH_SAMPLE_SIZE=25
REVISION_RETENTION_DAYS=30
REVISION_KEEP_PER_SCOPE=2
TZ=UTC
